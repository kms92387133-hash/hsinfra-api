SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Synology WebDAV upload target.
# Example: https://your-nas-domain:5006/inspection-photos
NAS_WEBDAV_BASE_URL=https://your-nas-domain:5006/inspection-photos
NAS_WEBDAV_USERNAME=your-nas-username
NAS_WEBDAV_PASSWORD=your-nas-password

# Synology Drive / Office spreadsheet source for one-way company sync.
SPREADSHEET_DRIVE_BASE_URL=https://drive.hsinfra.kr
SPREADSHEET_LINK_ID=your-office-share-link-id
SPREADSHEET_FILE_ID=optional-drive-file-id
SPREADSHEET_SHEET_ID=3
