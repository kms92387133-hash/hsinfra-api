SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Synology WebDAV upload target.
# Example: https://your-nas-domain:5006/inspection-photos
NAS_WEBDAV_BASE_URL=https://your-nas-domain:5006/inspection-photos
NAS_WEBDAV_USERNAME=your-nas-username
NAS_WEBDAV_PASSWORD=your-nas-password

# Synology File Station API target used by photo upload/download.
# Example: https://your-nas-domain:5001
NAS_FILESTATION_BASE_URL=https://your-nas-domain:5001
NAS_FILESTATION_ROOT_PATH=/photo

# Synology Drive / Office spreadsheet source for one-way company sync.
SPREADSHEET_DRIVE_BASE_URL=https://drive.hsinfra.kr
SPREADSHEET_LINK_ID=18VoRzuXn4H7vB06uBIcr0pVZQFk3cEH
SPREADSHEET_FILE_ID=optional-drive-file-id
SPREADSHEET_SHEET_NAME=업체리스트
SPREADSHEET_SHEET_ID=2

# Synology Calendar CalDAV target.
SYNOLOGY_CALDAV_URL=https://your-nas-domain:5001/caldav/your-calendar-path/
SYNOLOGY_CALDAV_USERNAME=your-nas-username
SYNOLOGY_CALDAV_PASSWORD=your-nas-password
